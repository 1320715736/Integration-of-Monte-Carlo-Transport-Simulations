\@writefile{toc}{\contentsline {subsubsection}{3.1 \(^{14}\mathrm {C}\) beta spectrum and energy-deposition distribution}{5}{section*.12}\protected@file@percent }
\newlabel{mathrmc-beta-spectrum-and-energy-deposition-distribution}{{}{5}{\texorpdfstring {3.1 \(^{14}\mathrm {C}\) beta spectrum and energy-deposition distribution}{3.1 \^{}\{14\}\textbackslash mathrm\{C\} beta spectrum and energy-deposition distribution}}{section*.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Fig.4. \(^{14}\mathrm {C}\) beta spectrum and Geant4 sampled result. The average energy is about \(49\ \mathrm {keV}\), and the maximum energy is \(156.5\ \mathrm {keV}\).}}{5}{figure.caption.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Fig.5. Depth-dependent energy-deposition distributions of different source terms in 4H-SiC. The \(10\), \(20\), and \(30\ \mathrm {keV}\) curves are used to illustrate the low-energy deposition trend; only \(20\), \(49\), \(100\), \(156.5\ \mathrm {keV}\), and the \(^{14}\mathrm {C}\) continuous spectrum are used as comparison source terms in the subsequent thickness optimization.}}{5}{figure.caption.14}\protected@file@percent }
